{
  "version": "1.0",
  "reporting_date": "2026-04-24",
  "week1_start": "2026-03-30",
  "notes": "Expected outputs computed from data/*.csv with eval/compute_expected.py. Checks are machine-scored by eval/checks.py and the n8n 'Evaluate Output' node. required=false checks are tracked but do not fail a test.",
  "tests": [
    {
      "test_id": "T1",
      "type": "baseline",
      "category": "Plan (detailed)",
      "input": "Generate a project plan for the AI Adoption Project at ABCDE Ltd. Use the provided project description.",
      "expected_route": "plan",
      "expected_output": "Structured plan grounded in the description and timeline: all 8 phases in order with weeks 1-24 and dates, key activities, milestones/deliverables (e.g. 'Project charter signed off', 'Gap analysis report', 'Full production rollout'), goals quoted exactly (15% fewer delivery delays, 10% lower operational costs, improved service responsiveness). No invented goals, KPIs, budgets or phases.",
      "checks": [
        {
          "id": "route",
          "type": "route",
          "value": "plan",
          "label": "routed to plan"
        },
        {
          "id": "p1",
          "type": "regex",
          "pattern": "Project Initiation",
          "label": "Phase 1 name"
        },
        {
          "id": "p2",
          "type": "regex",
          "pattern": "Current State Analysis",
          "label": "Phase 2 name"
        },
        {
          "id": "p3",
          "type": "regex",
          "pattern": "Use Case Selection",
          "label": "Phase 3 name"
        },
        {
          "id": "p4",
          "type": "regex",
          "pattern": "Pilot Design",
          "label": "Phase 4 name"
        },
        {
          "id": "p5",
          "type": "regex",
          "pattern": "Pilot Implementation",
          "label": "Phase 5 name"
        },
        {
          "id": "p6",
          "type": "regex",
          "pattern": "Evaluation (&|and) Iteration",
          "label": "Phase 6 name"
        },
        {
          "id": "p7",
          "type": "regex",
          "pattern": "Full Deployment",
          "label": "Phase 7 name"
        },
        {
          "id": "p8",
          "type": "regex",
          "pattern": "Monitoring (&|and) Review",
          "label": "Phase 8 name"
        },
        {
          "id": "g15",
          "type": "regex",
          "pattern": "15\\s?%",
          "label": "goal: 15% fewer delivery delays"
        },
        {
          "id": "g10",
          "type": "regex",
          "pattern": "10\\s?%",
          "label": "goal: 10% lower operational costs"
        },
        {
          "id": "w24",
          "type": "regex",
          "pattern": "24 weeks|week 24|weeks? 23\\s?[-–]\\s?24|23-24",
          "label": "24-week timeline"
        },
        {
          "id": "charter",
          "type": "regex",
          "pattern": "charter",
          "label": "milestone: project charter"
        },
        {
          "id": "pct",
          "type": "percents_allowed",
          "allowed": [
            "15",
            "10"
          ],
          "label": "no invented percentages"
        },
        {
          "id": "grounded",
          "type": "ids_grounded",
          "label": "every task/risk ID exists in the data"
        }
      ]
    },
    {
